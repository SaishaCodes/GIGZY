# Database
DATABASE_URL="postgresql://username:password@localhost:5432/gigzy?schema=public"

# Authentication (Clerk or custom)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Payment (Stripe or similar)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Platform Configuration
PLATFORM_COMMISSION_RATE="0.15"  # 15% commission
MIN_WITHDRAWAL_AMOUNT="10"
MAX_WORKING_RADIUS="5.0"  # km

# Email/Notifications (SendGrid, etc.)
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@gigzy.app"

# File Upload (Cloudinary, S3, etc.)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Maps/Location
NEXT_PUBLIC_MAPS_API_KEY=""

# Socket/Real-time
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"